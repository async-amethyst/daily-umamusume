@page "/"
@using DailyUma.Core
@using DailyUma.Core.Enums
@using DailyUma.Web.Data
@inject HttpClient Http

<PageTitle>DailyUma</PageTitle>
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Aldrich&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: "Noto Sans", sans-serif;
            --bs-body-bg: transparent;
            background-color: transparent;
        }

        body::before {
            content:"";
            position: fixed;
            inset: -20px;
            z-index: 0;
            background-image: 
                linear-gradient(rgba(0, 0, 0, 0.55), rgba(0,0,0,0.55)),
                url("img/bg/debug_bg.png") !important;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: blur(8px);
        }
    </style>
</head>

<h1 class="header">UMADAILY!</h1>
<p style="text-align: center;"><i>Guess the daily Uma by their characteristics.</i></p>

<div class="guess-container mb-2" style="max-width: 400px;">
    <div class="input-group">
        <input @bind="userGuess"
            @bind:event="oninput"
            @onfocus="() => showDropdown = true"
            @onblur="HideDropdownDelayed"
            disabled="@inputDisabled"
            class="form-control"
            style="color:white !important"
            placeholder="Guess your Uma!" />
        <button @onclick="CheckGuess" class="btn btn-primary glass">Submit Guess!</button>
    </div>

    @if (showDropdown && _umaNameListFiltered.Any())
    {
        <ul class="guess-dropdown glass">
            @foreach (var uma in _umaNameListFiltered)
            {
                <li @onmousedown="() => SelectUma(uma)">
                    @uma
                </li>
            }
        </ul>
    }
</div>

<datalist id="name-options">
    @foreach(var name in _umaNameList)
    {
        <option value="@name"/>
    }
</datalist>

@if (_guesses.Any())
{
    <table class="table table-bordered guess-table text-center align-middle mt-4 glass">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th>Gender</th>
                <th>Hair Color</th>
                <th>Generation</th>
                <th>Surface Aptitude</th>
                <th>Distance Aptitude</th>
                <th>Running Style</th>
                <th>G1 Race Wins</th>
                <th>G2 Race Wins</th>
                <th>G3 Race Wins</th>
                <th>Release Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (guess, comparison)in _guesses.Zip(_guessComparisons)) // I can get a tuple from these with zip and I think that's pretty fucking cool
            {
                <tr>
                    <td><img src="@guess.GetImgSpritePath()" alt="@guess.Name" style="width: 50px; height: 50px;" /></td>
                    <td>@guess.Name</td>
                    <td class="@(comparison.Gender ? "table-success" : "table-danger")">@guess.GenderToString()</td>
                    <td class="@(comparison.HairColor ? "table-success" : "table-danger")">@guess.HairColorToString()</td>
                    <td class="@((comparison.Generation == Core.Enums.ComparisonResult.Equal) ? "table-success" : "table-danger")">@guess.Generation (@((MarkupString)comparison.Generation.ToReadableString()))</td>
                    <td class="@guess.Aptitudes.GetSurfaceAptitudeColor(_dailyUma.Aptitudes)">@guess.Aptitudes.GetSurfaceAptitudeString()</td>
                    <td class="@guess.Aptitudes.GetDistanceAptitudeColor(_dailyUma.Aptitudes)">@guess.Aptitudes.GetDistanceAptitudeString()</td>
                    <td class="@guess.Aptitudes.GetStyleAptitudeColor(_dailyUma.Aptitudes)">@guess.Aptitudes.GetStyleAptitudeString()</td>
                    <td class="@((comparison.G1 == Core.Enums.ComparisonResult.Equal) ? "table-success" : "table-danger")">@guess.G1Wins (@((MarkupString)comparison.G1.ToReadableString()))</td>
                    <td class="@((comparison.G2 == Core.Enums.ComparisonResult.Equal) ? "table-success" : "table-danger")">@guess.G2Wins (@((MarkupString)comparison.G2.ToReadableString()))</td>
                    <td class="@((comparison.G3 == Core.Enums.ComparisonResult.Equal) ? "table-success" : "table-danger")">@guess.G3Wins (@((MarkupString)comparison.G3.ToReadableString()))</td>
                    <td class="@((comparison.ReleaseDate == Core.Enums.ComparisonResult.Equal) ? "table-success" : "table-danger")">@guess.ReleaseDate.ToString("MMMM dd yyyy") (@((MarkupString)comparison.ReleaseDate.ToReadableString()))</td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="@messageColor">@statusMessage</p>

@code {
    private WebUmaDatabase? _umaDb;
    private string? loadStatus;
    private string? userGuess;
    private string? statusMessage;
    private string? messageColor; // sets color of message just for testing
    private bool showDropdown = false;
    private bool inputDisabled = false;
    private int guessCount = 0;
    private const int GUESS_COUNT_MAX = 6;
    private UmaEntry? _dailyUma;
    private List<string> _umaNameList = new List<string>();
    private List<UmaEntry> _guesses = new List<UmaEntry>();
    private List<UmaComparison> _guessComparisons = new List<UmaComparison>();

    protected override async Task OnInitializedAsync()
    {
        loadStatus = "Attempting to load the Database....";
        _umaDb = new WebUmaDatabase(Http);
        await _umaDb.Initialize();
        await _umaDb.InitializeSeed(GameMode.Daily);
        _umaNameList = await _umaDb.GetUmaNameList();
        _dailyUma = _umaDb.dailyUma;
        loadStatus = "Successfully loaded data I think??";
    }

    private void CheckGuess()
    {
        if(!_umaDb.TryGetUma(userGuess, out var uma))
        {
            statusMessage = "No matching Umamusume found in the database.";
            messageColor = "text-danger";
            return;
        }
        _guesses.Add(uma);
        _guessComparisons.Add(uma.CompareTo(_dailyUma));
        if(uma == _dailyUma)
        {
            statusMessage = $"Congrats! The daily umamusume was: {uma.Name}";
            messageColor = "table-success";
            inputDisabled = true;
            userGuess = string.Empty;
            return;
        }
        guessCount++;
        if(guessCount >= GUESS_COUNT_MAX)
        {
            statusMessage = $"Sorry, you ran out of guesses! The daily umamusume was: {_dailyUma.Name}";
            messageColor = "table-danger";
            inputDisabled = true;
        }
        userGuess = string.Empty;
    }

    private IEnumerable<string> _umaNameListFiltered =>
        string.IsNullOrWhiteSpace(userGuess) // if the guess is empty, show just the name list. otherwise, filter by what they've typed
            ? _umaNameList
            : _umaNameList.Where(name => name.Contains(userGuess, StringComparison.OrdinalIgnoreCase)); // ignore upper/lower case

    private void SelectUma(string uma) // when user selects uma from dropdown
    {
        userGuess = uma;
        showDropdown = false;
    }

    private async Task HideDropdownDelayed()
    {
        await Task.Delay(150);
        showDropdown = false;
    }
}